{
	"name": "n8n-nodes-techmap",
	"version": "0.1.1",
	"description": "n8n community node for the Techmap job postings APIs: search daily international job postings and build RSS feed URLs.",
	"license": "MIT",
	"homepage": "https://jobdatafeeds.com",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"techmap",
		"jobs",
		"job-postings",
		"job-data",
		"rss",
		"rapidapi"
	],
	"author": {
		"name": "Techmap GmbH",
		"email": "data@techmap.io"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/TechMap/n8n.techmap.io.git"
	},
	"bugs": {
		"url": "https://github.com/TechMap/n8n.techmap.io/issues"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:tsc": "tsc",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"test": "jest",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist",
		"!dist/tsconfig.tsbuildinfo",
		"!dist/**/*.map"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/TechmapApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Techmap/Techmap.node.js",
			"dist/nodes/TechmapTrigger/TechmapTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.50.4",
		"@types/jest": "^29.5.14",
		"eslint": "9.39.4",
		"jest": "^29.7.0",
		"n8n-workflow": "^2.41.2",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"ts-jest": "^29.4.14",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
